---
interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;

const links = [
  { name: "About", href: "/about" },
  { name: "Resume", href: "/resume" },
  { name: "Projects", href: "/projects" },
  { name: "Lab", href: "/lab/", featured: true },
];

const normalizePath = (path: string) =>
  path === "/" ? path : path.replace(/\/$/, "");

const activePath = normalizePath(currentPath);
---

<nav class="site-nav" aria-label="Primary navigation">
  <div class="nav-inner">
    <a class="brand" href="/" aria-label="Oscar Granados home">
      <img src="/main-site-icon-v4.png" alt="" aria-hidden="true" />
      <span>Oscar Granados</span>
    </a>

    <div class="nav-links">
      {
        links.map((link) => {
          const isActive = activePath === normalizePath(link.href);

          return (
            <a
              class:list={["nav-link", { featured: link.featured }]}
              href={link.href}
              aria-current={isActive ? "page" : undefined}
            >
              {link.name}
            </a>
          );
        })
      }
    </div>
  </div>
</nav>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid rgb(31 198 229 / 12%);
    background: rgb(13 11 18 / 88%);
    box-shadow: 0 0.75rem 2.5rem rgb(0 0 0 / 18%);
    backdrop-filter: blur(18px) saturate(125%);
  }

  .nav-inner {
    display: flex;
    width: min(100%, var(--site-width));
    min-height: 4.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin: 0 auto;
    padding: 0.75rem var(--page-gutter);
  }

  .brand {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    gap: 0.7rem;
    color: var(--color-text);
    font-weight: 650;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }

  .brand img {
    width: 2rem;
    height: 2rem;
    flex: 0 0 auto;
    border-radius: 0.55rem;
    box-shadow: 0 0 1.2rem rgb(15 182 214 / 13%);
    object-fit: cover;
  }

  .brand:hover {
    color: var(--color-cyan-high);
  }

  .nav-links {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.35rem;
  }

  .nav-link {
    border: 1px solid transparent;
    border-radius: 0.45rem;
    color: var(--color-text-soft);
    font-size: 0.92rem;
    font-weight: 560;
    line-height: 1;
    padding: 0.62rem 0.75rem;
    text-decoration: none;
    transition:
      color 150ms ease,
      border-color 150ms ease,
      background-color 150ms ease;
  }

  .nav-link:hover {
    border-color: rgb(31 198 229 / 20%);
    background: rgb(31 198 229 / 6%);
    color: var(--color-text);
  }

  .nav-link[aria-current="page"] {
    border-color: rgb(31 198 229 / 26%);
    background: linear-gradient(90deg, rgb(31 198 229 / 14%), rgb(244 86 157 / 5%));
    color: var(--color-cyan-high);
    box-shadow: inset 2px 0 var(--color-cyan);
  }

  .nav-link.featured {
    margin-inline-start: 0.25rem;
    border-color: var(--color-border-strong);
    background: rgb(25 22 33 / 65%);
    color: var(--color-text);
  }

  .nav-link.featured:hover,
  .nav-link.featured[aria-current="page"] {
    border-color: rgb(31 198 229 / 38%);
    background: rgb(31 198 229 / 9%);
    color: var(--color-cyan-high);
  }

  @media (max-width: 43rem) {
    .nav-inner {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.65rem;
      padding-block: 0.75rem 0.65rem;
    }

    .nav-links {
      width: 100%;
      justify-content: flex-start;
      overflow-x: auto;
      padding-block-end: 0.1rem;
      scrollbar-width: none;
    }

    .nav-links::-webkit-scrollbar {
      display: none;
    }

    .nav-link {
      flex: 0 0 auto;
    }
  }
</style>
